# エックスサーバー接続情報（コピーして deploy.env を作成。コミット禁止）

# SSH接続（サーバーパネル「SSH設定」で確認）
SSH_USER=xxxxxxxx                 # サーバーID
SSH_HOST=svXXXX.xserver.jp        # サーバー番号.xserver.jp
SSH_PORT=10022
SSH_KEY=~/.ssh/xserver_locona     # 登録した公開鍵に対応する秘密鍵

# 設置先（ドメイン配下）
DOMAIN=locona.example.com         # 追加済みドメイン/サブドメイン
REMOTE_BASE=~/${DOMAIN}           # 通常はこのまま（~/{ドメイン}）

# サーバー上のPHPコマンド（PHP Ver.切替で確認。例 /usr/bin/php8.3）
REMOTE_PHP=php

# 初回デプロイでサンプルデータも投入するなら true
SEED_ON_FIRST_DEPLOY=true

# 本番 .env に書き込む値（初回のみ使用）
APP_URL=https://locona.example.com
DB_DATABASE=xxxx_locona
DB_USERNAME=xxxx_locona
DB_PASSWORD=__set_me__
